//! format:aeos-v1
aeos:schema = {
  rules:list<object> = [
    {
      path:sansa = $.[""]
      constraints:object = {
        required:boolean = true
        type:string = "NodeLiteral"
      }
    }
    {
      selector:sansa = $.[""][0].*[0].@.sku
      constraints:object = {
        type:string = "StringLiteral"
        min_length:number = 2
      }
    }
    {
      selector:sansa = $.[""][0].*[0].@.active
      constraints:object = {
        type:string = "StringLiteral"
      }
    }
    {
      path:sansa = $.[""][0][0][0][0][0][0]
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
      }
    }
    {
      path:sansa = $.[""][0][0][0][1]
      constraints:object = {
        required:boolean = true
        type:string = "StringLiteral"
        datatype:string = "cdata"
      }
    }
  ]
}
