//! format:aeos-v1
aeos:schema = {
  rules:list<object> = [
    {
      path:sansa = $.[""]
      constraints:object = {
        required:boolean = true
        type:string = "ListNode"
      }
    }
    {
      selector:sansa = $.[""].*
      constraints:object = {
        type:string = "ListNode"
        length_exact:number = 4
      }
    }
    {
      selector:sansa = $.[""].*[0]
      constraints:object = {
        type:string = "StringLiteral"
        min_length:number = 2
      }
    }
    {
      selector:sansa = $.[""].*[1]
      constraints:object = {
        type:string = "NumberLiteral"
        min_value:number = 0
      }
    }
    {
      selector:sansa = $.[""].*[2]
      constraints:object = {
        type:string = "BooleanLiteral"
      }
    }
    {
      selector:sansa = $.[""].*[3]
      constraints:object = {
        type:string = "DateLiteral"
      }
    }
  ]
}
