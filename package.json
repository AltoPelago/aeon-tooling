{
  "name": "aeon-tooling",
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "test": "npm run test --prefix web/highlighter/aeon-code-block && npm run test --prefix converters/md-to-and && npm run test:adapters",
    "test:web": "npm run test --prefix web/highlighter/aeon-code-block",
    "test:md-to-and": "npm run test --prefix converters/md-to-and",
    "install:vscode": "pnpm --dir ide/vscode/aeon install --frozen-lockfile --node-linker=hoisted",
    "test:vscode:grammar": "pnpm --dir ide/vscode/aeon test:grammar",
    "package:vscode": "pnpm --dir ide/vscode/aeon package",
    "test:vscode:bundle": "node --test ide/vscode/aeon/test/bundle.test.mjs",
    "test:tree-sitter": "npm run test --prefix grammar/tree-sitter-aeon",
    "build:quicklook": "bash ide/quicklook/scripts/build.sh",
    "install:quicklook": "bash ide/quicklook/scripts/install.sh",
    "uninstall:quicklook": "bash ide/quicklook/scripts/uninstall.sh",
    "clean": "bash scripts/cleanup-public.sh --write",
    "clean:check": "bash scripts/cleanup-public.sh --check",
    "check:local-paths": "bash scripts/check-no-local-paths.sh",
    "precommit": "bash scripts/pre-commit-check.sh",
    "test:adapters": "node --test converters/format-adapters/test/*.test.js converters/format-adapters/*-core/test/*.test.js",
    "install:adapters": "npm ci --ignore-scripts --prefix converters/format-adapters/alog-core && npm ci --ignore-scripts --prefix converters/format-adapters/yaml-core",
    "playground:adapters": "node converters/format-adapters/playground/server.mjs"
  },
  "devDependencies": {
    "@altopelago/aeon-highlight": "file:.candidate-packages/altopelago-aeon-highlight-0.17.0-rc.1-3b1c408c104a.tgz",
    "@altopelago/aeon-lexer": "file:.candidate-packages/altopelago-aeon-lexer-0.17.0-rc.1-ac967ffcab16.tgz"
  }
}
